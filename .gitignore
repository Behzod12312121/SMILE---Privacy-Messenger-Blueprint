*.tsbuildinfo

# android
android/.gradle/
android/build/
android/*/build/
android/local.properties

# emulator / local
*.apk
*.aab

# local scratch scripts, not part of the product
scratch/

# deployment secrets
# never does.
deploy/**/.env

# Notes kept out of the published tree. The folder name says so; git does not
# read folder names, and an untracked directory is committed like any other.
SECRET - Nogo github/

# The NDK's CMake and Ninja working directory. android/*/build/ is ignored and
# machine that built it.
android/*/.cxx/

# Signing key material. Nothing here is committed today and the build reads
# build that reads the messages. Belt as well as braces.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Private keys and certificates, wherever they land.
*.pem
*.key
*.crt
*.der

# Local Gradle/SDK paths, wherever they land. Machine-specific, never portable.
local.properties

# Per-developer tool state. Not the product, and settings.local.json in
# particular records one machine's permission decisions.
.idea/
*.iml
.vscode/

# OS cruft
.DS_Store
Thumbs.db


# stay in the working tree and still run locally.
**/*FuzzTest.kt
